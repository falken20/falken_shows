# ============================================================
# Live Memories – Environment variables example
# Copy to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME="Live Memories"
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# ── Backend server ────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Used inside the frontend build to point at the API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ── Database ──────────────────────────────────────────────────
# SQLite (default for local development)
DATABASE_URL=sqlite+aiosqlite:///./data/live_memories.db

# PostgreSQL (production / local Docker profile)
# DATABASE_URL=postgresql+asyncpg://live_memories:change_me@localhost:5432/live_memories

# ── JWT Authentication ────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Admin user (created on first run) ─────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production

# ── Storage ───────────────────────────────────────────────────
# "local" for development, "gcs" for Google Cloud Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/uploads

# Google Cloud Storage (only needed when STORAGE_BACKEND=gcs)
GCS_BUCKET_NAME=
GCP_PROJECT_ID=

# ── File uploads ──────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Internationalisation ──────────────────────────────────────
DEFAULT_LANGUAGE=es
DEFAULT_CURRENCY=EUR
DEFAULT_TIMEZONE=Europe/Madrid

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Cloud SQL (only for Cloud Run / production) ───────────────
CLOUD_SQL_CONNECTION_NAME=
